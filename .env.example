# Copy to .env and fill in. All variables are optional; defaults are in app/config.py.

# Data backend used when a request does not specify one: cdse_openeo | synthetic | files
S1CD_DEFAULT_BACKEND=cdse_openeo

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu, free account)
# Option A - OIDC client credentials (non-interactive; register a client in the CDSE portal):
S1CD_CDSE_CLIENT_ID=
S1CD_CDSE_CLIENT_SECRET=
# Option B - leave both empty: the first run prints a device-code URL, the refresh token is cached.

# sigma0-ellipsoid (always available) or gamma0-terrain (better in relief)
S1CD_CDSE_BACKSCATTER_COEFFICIENT=sigma0-ellipsoid
S1CD_CDSE_MASK_PERMANENT_WATER=true

# Processing
S1CD_RESOLUTION_M=20
S1CD_MAX_AOI_KM2=5000
S1CD_RUNS_DIR=runs

# Persistence: unset = in-memory; set to use PostGIS (docker-compose sets this for you)
# S1CD_DATABASE_URL=postgresql://s1cd:s1cd@localhost:5432/s1cd

# Run POST /change synchronously by default (the API also honours ?wait=true)
S1CD_SYNC=false
